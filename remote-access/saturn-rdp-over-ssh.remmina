[remmina]
name=Saturn RDP over SSH
group=Remote Access
protocol=RDP
server=127.0.0.1:3389
username=example-user
domain=
password=
resolution_mode=2
colordepth=32
quality=9
network=auto
security=negotiate
cert_ignore=0
disablepasswordstoring=1
ssh_tunnel_enabled=1
ssh_tunnel_loopback=1
ssh_tunnel_server=192.0.2.24:22
ssh_tunnel_username=example-user
ssh_tunnel_auth=2
ssh_tunnel_privatekey=
ssh_tunnel_password=
ssh_tunnel_passphrase=
ssh_tunnel_stricthostkeycheck=1

#!/usr/bin/env bash

# SSH_ASKPASS/GIT_ASKPASS replacement that prompts on the controlling
# terminal instead of popping a GUI dialog (e.g. ksshaskpass), and echoes
# a "*" per character instead of ssh-add's own silent, echo-less prompt.
#
# Contract (see ssh-add(1)/ssh(1) SSH_ASKPASS): only the passphrase itself
# goes to stdout. Everything else - the prompt and the asterisks - is
# written straight to the terminal so it never ends up in the captured
# secret.

set -Eeuo pipefail

prompt=${1:-Passphrase:}

if [[ ! -e /dev/tty ]]; then
  # No controlling terminal to prompt on (e.g. a fully detached autostart
  # context) - nothing we can do, so decline rather than hang or fall back
  # to a GUI dialog.
  exit 1
fi

exec {tty_fd}<>/dev/tty

old_stty=$(stty -g <&"$tty_fd")
restore() {
  stty "$old_stty" <&"$tty_fd" 2>/dev/null || true
}
trap restore EXIT INT TERM

stty -echo <&"$tty_fd"
printf '%s ' "$prompt" >&"$tty_fd"

passphrase=""
while IFS= read -r -s -n 1 char <&"$tty_fd"; do
  if [[ -z $char ]]; then
    break
  fi
  if [[ $char == $'\x7f' || $char == $'\x08' ]]; then
    if [[ -n $passphrase ]]; then
      passphrase=${passphrase%?}
      printf '\b \b' >&"$tty_fd"
    fi
    continue
  fi
  passphrase+="$char"
  printf '*' >&"$tty_fd"
done

printf '\n' >&"$tty_fd"
printf '%s' "$passphrase"

[Unit]
Description=WayVNC remote desktop server for Hyprland
Documentation=man:wayvnc(1)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/wayvnc --config=%h/.config/wayvnc/config --output=DP-2 --max-fps=30
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
